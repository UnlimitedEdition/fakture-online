# Supabase — dedicated Fakture Online project (NOT shared with any other app)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role — used by cron endpoints only (NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Site URL — used to verify Origin on POST endpoints (CSRF defense) and to
# generate the SEF callback URL
NEXT_PUBLIC_SITE_URL=https://fakture.example.com

# Resend — transactional email (optional but recommended)
RESEND_API_KEY=re_xxx
NOTIFICATION_EMAIL=leads@example.com

# Admin allow-list — comma-separated emails granted admin access
# Leave empty to disable email-based admin grant; use fo_profiles.is_admin instead.
ADMIN_EMAILS=

# Upstash Redis — rate limiting (required for production)
# Get from https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# SEF (Sistem Elektronskih Faktura) integration
# 32-byte master key (64 hex chars) used to AES-GCM encrypt per-user SEF API keys.
# Generate with: openssl rand -hex 32
SEF_KEY_ENCRYPTION_KEY=

# Shared secret for protecting /api/cron/sef-* endpoints. Send as X-Cron-Secret header.
# Generate with: openssl rand -hex 32
SEF_CRON_SECRET=

# Optional: URL to a JSON list of KJS (budget users) for daily registry refresh.
# If unset, the KJS refresh cron skips (B2G eligibility check then falls back to
# the cached SEF companies registry).
KJS_REGISTRY_URL=
